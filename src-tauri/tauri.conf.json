{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apilator",
  "version": "0.9.0",
  "identifier": "com.lexandro.apilator",
  "build": {
    "beforeDevCommand": "bun run vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Apilator",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "backgroundColor": "#1a1b26"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lexandro/apilator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5QkU0RjlCOTU0RDk4MjAKUldRZ21FMlZtMCsrcVJPLzcxcXY2WDJUd0Y0dkl3T1B6YU9idFJLTkZWbHlPWGQ2RVJEMmxONDEK"
    }
  }
}
